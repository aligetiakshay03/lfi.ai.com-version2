# lfiai.com - Apache configuration (deployed with the build by the FTP mirror).
#
# What this replaces: a catch-all that answered every URL with index.html and
# HTTP 200. That made every mistyped URL, and every missing JS chunk, look
# like a real copy of the homepage to search engines (a "soft 404").
#
# Now:
#   1. One canonical host: http:// and www. redirect (301) to https://lfiai.com.
#   2. Real files are served as they are.
#   3. Each app route is served its own pre-built document (/demos ->
#      demos.html), generated by scripts/seo-build.mjs from src/data/seo.js.
#   4. Anything else is a real 404, rendered by the app's not-found page.

# Only FileInfo-class directives here (no Options/DirectoryIndex): those need
# extra AllowOverride rights, and a directive the host does not allow turns
# every request into a 500.
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Canonical host and scheme. X-Forwarded-Proto covers a TLS-terminating
  #    proxy in front of Apache, so this cannot loop behind one.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1) [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # /index.html is the homepage; keep one URL for it.
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  # 2. Real files.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 3. App routes. A trailing slash redirects to the canonical form first.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([^/.]+)$ $1.html [L]

  # 4. Everything else falls through to ErrorDocument 404.
</IfModule>

# Caching. CRA's /static files are content-hashed, so they never change in
# place and can be cached for a year. HTML must always be revalidated, or a
# deploy leaves visitors on old HTML pointing at deleted chunks.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.(webp|png|jpe?g|svg|ico|avif|woff2|mp4)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>
